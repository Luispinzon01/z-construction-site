# Free email delivery for the quote form (recommended first step).
# web3forms.com -> enter the business inbox -> copy the access key. 250 submissions/month free.
# Runs alongside the paid channels below; a lead counts as delivered if either path works.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ---------------------------------------------------------------------------
# Z Construction site — environment variables (set in Vercel → Settings →
# Environment Variables). Everything is optional: leave a value blank and
# that feature simply turns off. See docs/growth/07-lead-system.md.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://www.zconstructionremodeling.com
NEXT_PUBLIC_WHATSAPP=            # WhatsApp Business number, digits only, e.g. 13345550123

# --- Lead delivery -----------------------------------------------------------
# Email via Resend (https://resend.com): owner alert + auto-reply to the homeowner.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@zconstructionremodeling.com
QUOTE_FROM_EMAIL=quotes@zconstructionremodeling.com
LEAD_AUTOREPLY=1                 # 0 = don't email the homeowner an acknowledgment

# Instant text alert to the owner's phone (Twilio). Comma-separate several numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                     # your Twilio number, +1334...
LEAD_ALERT_SMS_TO=               # owner cell(s), +1334...
LEAD_SMS_AUTOREPLY=0             # 1 = text the homeowner (only if they ticked consent; needs A2P 10DLC registration)

# Every lead as JSON to your CRM / Zapier / Make / Google Sheet (see docs/growth/07-lead-system.md).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=             # sent as X-Lead-Secret header

# --- Tracking & ads ----------------------------------------------------------
NEXT_PUBLIC_GA4_ID=              # G-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=       # AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=        # conversion label for "Quote form lead"
NEXT_PUBLIC_GOOGLE_ADS_CALL_CLICK_LABEL=  # conversion label for "Click to call" (secondary)
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=        # "Calls from website" label (Google forwarding number swap)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=                 # Meta Conversions API access token (server-side Lead events)
META_TEST_EVENT_CODE=            # only while testing in Events Manager
NEXT_PUBLIC_MS_UET_ID=           # Microsoft Advertising UET tag ID (Bing + Copilot ads)
NEXT_PUBLIC_CALLRAIL_SCRIPT=     # CallRail dynamic number insertion script URL
NEXT_PUBLIC_GTM_ID=              # optional GTM-XXXXXXX, for adding pixels (ChatGPT Ads, Nextdoor…) without code
